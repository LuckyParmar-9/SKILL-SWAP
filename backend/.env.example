PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/skillswap
JWT_SECRET=change_this_to_a_long_random_secret
CLIENT_URL=http://localhost:5173
# In production, use your real domain, e.g.:
# CLIENT_URL=https://skillswap-one-rust.vercel.app
# Multiple origins (comma-separated) and "*" wildcards are supported, e.g. to also
# allow every Vercel preview-deployment URL for this project without editing this
# each time a new preview is generated:
# CLIENT_URL=https://skillswap-one-rust.vercel.app,https://skillswap-*.vercel.app
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Voice/video calls (https://dashboard.daily.co/signup - free tier available).
# Get this from Daily's dashboard under Developers > API keys.
DAILY_API_KEY=your_daily_api_key
